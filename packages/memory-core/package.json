{
	"type": "module",
	"name": "@gajae-code/memory-core",
	"version": "0.12.0",
	"description": "Deterministic, local-first filesystem memory engine for Gajae-Code.",
	"homepage": "https://gajae-code.com",
	"author": "Yeachan-Heo and Gajae Code Contributors",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Yeachan-Heo/gajae-code.git",
		"directory": "packages/memory-core"
	},
	"bugs": {
		"url": "https://github.com/Yeachan-Heo/gajae-code/issues"
	},
	"keywords": [
		"memory",
		"local-first",
		"filesystem",
		"markdown",
		"deterministic"
	],
	"main": "./src/index.ts",
	"types": "./src/index.ts",
	"scripts": {
		"check": "biome check . && bun run check:types",
		"check:types": "tsc -p tsconfig.json --noEmit",
		"lint": "biome lint .",
		"test": "bun test",
		"fix": "biome check --write --unsafe .",
		"fmt": "biome format --write ."
	},
	"devDependencies": {
		"@types/bun": "catalog:"
	},
	"engines": {
		"bun": ">=1.3.14"
	},
	"files": [
		"src",
		"README.md",
		"CHANGELOG.md",
		"tsconfig.publish.json"
	],
	"exports": {
		".": {
			"types": "./src/index.ts",
			"import": "./src/index.ts"
		},
		"./schemas": {
			"types": "./src/schemas/index.ts",
			"import": "./src/schemas/index.ts"
		},
		"./schemas/*.json": "./src/schemas/*.json",
		"./package.json": "./package.json"
	}
}
