{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gajae.memory.audit.v1",
  "title": "Gajae Memory Doctor Audit",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "healthy", "findings"],
  "properties": {
    "schemaVersion": {
      "const": "gajae.memory.audit.v1"
    },
    "healthy": {
      "type": "boolean"
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "severity", "relPath", "detail"],
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1
          },
          "severity": {
            "enum": ["info", "warning", "error"]
          },
          "relPath": {
            "type": ["string", "null"]
          },
          "detail": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
