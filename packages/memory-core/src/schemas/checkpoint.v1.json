{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gajae.memory.checkpoint.v1",
  "title": "Gajae memory checkpoint result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "uri",
    "digest",
    "sessionId"
  ],
  "properties": {
    "schemaVersion": {
      "const": "gajae.memory.checkpoint.v1"
    },
    "uri": {
      "type": "string",
      "pattern": "^session:\\/\\/[^?#]+$"
    },
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "sessionId": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!\\.\\.?$)(?!.*[\\\\/\\u0000:#?])(?!.+[. ]$).+$"
    }
  }
}
