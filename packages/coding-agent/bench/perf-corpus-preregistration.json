{
  "schema": "gjc.perf-corpus-preregistration/1",
  "analysisSchema": "gjc.perf-corpus-rlm-analysis/1",
  "reportSchema": "gjc.perf-corpus/3",
  "frozenBeforeOutcomes": true,
  "digestBinding": {
    "method": "external-sha256-receipts-after-freeze",
    "reason": "A cooperative self-hash cannot authenticate code that is already executing. The external runner authenticates this template before execution; the template opens the driver and preregistration once, hashes those exact bytes against external receipts, and compiles/executes only the verified driver bytes.",
    "embeddedDigests": false,
    "requiredExternalReceipts": [
      "templateSha256",
      "driverSha256",
      "preregistrationSha256"
    ]
  },
  "cohort": {
    "allMembersRequired": true,
    "gitDirtyRequired": false,
    "memoryIsolation": "process-per-surface",
    "profiles": {
      "short": {
        "requiredAdmittedBlocks": 5,
        "attemptCap": 5,
        "durationTargetMs": 0,
        "iterationsTarget": 200,
        "maximumPeriodicSamples": 22,
        "elapsedDurationToleranceMs": 30000
      },
      "soak": {
        "requiredAdmittedBlocks": 24,
        "attemptCap": 24,
        "durationTargetMs": 1000,
        "iterationsTarget": 100000,
        "maximumPeriodicSamples": 23,
        "elapsedDurationToleranceMs": 250
      }
    },
    "sameGitShaPlatformAndArchRequired": true,
    "independentReportBlocks": true
  },
  "bounds": {
    "maximumInputFiles": 29,
    "maximumBytesPerFile": 8388608,
    "maximumTotalInputBytes": 134217728,
    "maximumJsonDepth": 40,
    "maximumMarkdownBytes": 65536,
    "minimumElapsedDeltaMs": 0.001,
    "minimumAbsoluteActionSlopeBytesPerSecond": 1e-9,
    "maximumTheilSenPairsPerBaseline": 253
  },
  "analysis": {
    "descriptiveStatistics": [
      "minimum",
      "median",
      "maximum"
    ],
    "actionFamily": {
      "name": "sustained-heap-growth",
      "eligibleProfile": "soak",
      "eligibleSurfaces": [
        "agent-session",
        "tui"
      ],
      "primaryEstimator": "report-endpoint-heapSlopeBytesPerSecond",
      "sensitivityEstimator": "per-report-steady-state-Theil-Sen-heapUsedBytes-slope",
      "aggregation": "median-across-all-independent-report-blocks",
      "bootstrap": {
        "method": "two-sided-95-percent-BCa",
        "resamples": 10000,
        "resampleOverrideAllowed": false,
        "unit": "whole-report-block",
        "jointSurfaceResampling": true,
        "seed": 20260727,
        "indexGenerator": "sha256(seed:replicate:draw)-modulo-block-count",
        "quantile": "Hyndman-Fan-type-7",
        "biasTies": "half-weight"
      },
      "minimumPositiveSignsPerEstimatorPerSurface": 18,
      "minimumBcaLowerBoundBytesPerSecond": 34952.53333333333,
      "minimumBcaLowerBoundExpression": "1048576/30",
      "decision": "Action only when both eligible surfaces independently meet the endpoint BCa lower bound and both endpoint and Theil-Sen estimators have at least 18 positive report signs. All conditions are conjunctive.",
      "noMultiplicityExpansion": true
    },
    "p95Claim": "omitted",
    "otherSurfaces": "descriptive-only",
    "teardownAndObservedExtrema": "descriptive-only",
    "insufficientEvidenceRule": "Emit INSUFFICIENT_EVIDENCE with actionDecision NOT_EVALUATED unless every scheduled file is present, no other directory entry exists, exact profile counts are admitted, and every report passes structure, provenance, fixed resource bounds, control, seven-surface, and order validation. Validate every bounded scheduled member and report admitted, invalid, and not-evaluated counts without treating any member as excluded or replacing it after its scheduled attempt cap."
  },
  "exclusions": {
    "postOutcomeExclusionsAllowed": false,
    "invalidStructure": "fail-cohort-as-INSUFFICIENT_EVIDENCE",
    "missingScheduledBlock": "fail-cohort-as-INSUFFICIENT_EVIDENCE",
    "extraOrUnexpectedFile": "fail-cohort-as-INSUFFICIENT_EVIDENCE",
    "dirtyOrMismatchedGit": "fail-cohort-as-INSUFFICIENT_EVIDENCE",
    "orderOrControlDrift": "fail-cohort-as-INSUFFICIENT_EVIDENCE"
  },
  "captureControls": {
    "permutationGeneration": {
      "performedBeforeOutcomes": true,
      "algorithm": "For each block, sort the seven UTF-8 surface names by the raw SHA-256 digest of '20260727:<profile>:<two-digit-index>:<surface>'.",
      "seed": 20260727
    },
    "requiredSurfaces": [
      "cli",
      "agent-session",
      "blob-store",
      "worker",
      "telegram-daemon",
      "tui",
      "shared-native"
    ],
    "schedule": [
      { "blockId": "short-01", "profile": "short", "expectedFilename": "short-01.json", "surfaceOrder": ["tui", "worker", "shared-native", "cli", "agent-session", "telegram-daemon", "blob-store"] },
      { "blockId": "short-02", "profile": "short", "expectedFilename": "short-02.json", "surfaceOrder": ["worker", "agent-session", "tui", "telegram-daemon", "shared-native", "blob-store", "cli"] },
      { "blockId": "short-03", "profile": "short", "expectedFilename": "short-03.json", "surfaceOrder": ["telegram-daemon", "blob-store", "shared-native", "agent-session", "tui", "worker", "cli"] },
