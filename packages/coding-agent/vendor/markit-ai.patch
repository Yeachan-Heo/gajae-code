-                const [x1, y1] = ctmApply(ctm, r.x + r.w, r.y + r.h);
-                pushStrokedRectEdges(segments, sid(), Math.min(x0, x1), Math.min(y0, y1), Math.abs(x1 - x0), Math.abs(y1 - y0));
