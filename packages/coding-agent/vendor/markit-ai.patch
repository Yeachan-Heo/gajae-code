-        text: w.text.trim(),
-        pageNumber,
-        fontSize: w.fontSize,
-        isBold: w.isBold,
-        bounds: {
-            left: w.x,
-            right: w.x + w.width,
-            bottom: w.y,
-            top: w.y + w.height,
-        },
