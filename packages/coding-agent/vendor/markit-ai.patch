-            const sep = gap > 1 ? " " : "";
-            cur.text += sep + next.text;
-            cur.width = next.x + next.width - cur.x;
-            cur.height = Math.max(cur.height, next.height);
-            cur.fontSize = Math.max(cur.fontSize, next.fontSize);
-            cur.isBold = cur.isBold || next.isBold;
-        }
-        else {
-            merged.push(cur);
-            cur = { ...next };
-        }
-    }
-    merged.push(cur);
-    return merged;
-}
